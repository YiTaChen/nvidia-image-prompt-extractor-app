NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_PROVIDER=nvidia
VLM_MODEL=nvidia/nemotron-nano-12b-v2-vl
# Required for real image generation. Example for a local Visual GenAI NIM:
# NVIDIA_IMAGE_BASE_URL=http://localhost:8000/v1
NVIDIA_IMAGE_BASE_URL=
NVIDIA_VLM_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
NVIDIA_IMAGE_MODEL=qwen/qwen-image-2512
NVIDIA_EMBEDDING_MODEL=nvidia/nvclip

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_VLM_MODEL=gemini-2.5-flash

LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_VLM_MODEL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VLM_MODEL=

IMAGE_PROVIDER=pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=kontext
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=
COMFYUI_WORKFLOW=qwen_image_edit_plus_text_to_image
COMFYUI_IMAGE_TO_IMAGE_WORKFLOW=image_to_image_basic
COMFYUI_MULTI_IMAGE_EDIT_WORKFLOW=qwen_image_edit_plus_multi_image_edit
COMFYUI_CHECKPOINT=
COMFYUI_DENOISE_STRENGTH=0.55
COMFYUI_TIMEOUT_SECONDS=300
COMFYUI_POLL_INTERVAL_SECONDS=1

DEFAULT_SIMILARITY_THRESHOLD=80
MAX_ITERATIONS=3
IMAGE_OUTPUT_SIZE=1024
USE_MOCK_NVIDIA=false
